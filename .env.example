# Copy to .env to override defaults. Every line is optional.
# (Comments are on their own lines on purpose: `docker run --env-file` does not strip inline comments.)

# --- GosPlan ---
# Default (nothing set): the free test server https://v2test.gosplan.info (no key, 10 requests/minute per IP).
# Optional API key for the production server https://v2.gosplan.info (sent as the `apikey` header).
# With a key and no GOSPLAN_BASE_URL the app uses the production server automatically.
# GOSPLAN_API_KEY=
# Override the server explicitly (always wins over the choice above):
# GOSPLAN_BASE_URL=https://v2test.gosplan.info
# seconds per HTTP attempt
GOSPLAN_TIMEOUT=20
# extra attempts on timeouts / 429 / 5xx (exponential backoff + jitter)
GOSPLAN_RETRIES=3
# base delay in seconds (0.5, 1, 2, ...)
GOSPLAN_BACKOFF=0.5
# max parallel requests to GosPlan
GOSPLAN_CONCURRENCY=8

# --- limits ---
# max purchase numbers/records per POST /api/tenders
MAX_BATCH_SIZE=1000
LOG_LEVEL=INFO

# --- host ---
HOST_PORT=8000

# --- map (leave these unset for the OpenStreetMap default) ---
# Raster tile template. Set it EMPTY to disable tiles entirely: the map then shows only the
# bundled country/region borders and works fully offline.
# MAP_TILE_URL=
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# MAP_TILE_MAX_ZOOM=18

# --- advanced (set by the container; normally leave as is) ---
# DB_PATH=/data/tenders.db
# ARTIFACT_PATH=/app/artifacts/hf_model
# MODEL_AUTOLOAD=1
